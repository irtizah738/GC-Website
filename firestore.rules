rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: tenants
    // Fields: tenantId (string), type (string), createdAt (number), expiresAt (number)
    //
    // Collection: events
    // Fields: eventId (string), tenantId (string), aggregateType (string), aggregateId (string), 
    //         eventType (string), payload (map), metadata (map)
    //
    // Collection: readModels
    // Fields: tenantId (string), [other fields based on type]
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    
    function isAuthenticated() {
      return request.auth != null;
    }

    // In a real app, tenantId would be in custom claims.
    // For this demo, we'll allow users to read/write data if they provide a valid tenantId.
    // In production, we'd use: request.auth.token.tenant_id == tenantId
    function isTenantOwner(tenantId) {
      return isAuthenticated(); // Simplified for demo, but normally checks claims
    }

    function isValidEvent(data) {
      return data.keys().hasAll(['eventId', 'tenantId', 'aggregateType', 'aggregateId', 'eventType', 'payload', 'metadata']) &&
             data.tenantId is string &&
             data.eventId is string &&
             data.metadata is map &&
             data.metadata.timestamp is number;
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /tenants/{tenantId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.tenantId == tenantId;
      allow update, delete: if false;
    }

    match /events/{eventId} {
      // Allow reading events for a specific tenant
      allow read: if isAuthenticated() && resource.data.tenantId != null;
      
      // Allow creating events
      allow create: if isAuthenticated() && isValidEvent(request.resource.data);
      
      // Events are immutable
      allow update, delete: if false;
    }

    match /readModels/{type}/{id} {
      allow read: if isAuthenticated();
      
      // Read models are updated by system/cloud functions in production.
      // For demo purposes, we might allow client-side updates if needed, 
      // but let's keep it restricted for now to show "System Integrity".
      allow write: if false; 
    }

    // Default deny
    match /{path=**} {
      allow read, write: if false;
    }
  }
}
