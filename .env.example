# Server-only Vercel runtime configuration
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=help@gothamcoders.com

# Optional comma-separated origin allowlist.
# If omitted, the API allows both production hostnames below by default:
# https://gothamcoders.com
# https://www.gothamcoders.com
SITE_ORIGIN=https://gothamcoders.com,https://www.gothamcoders.com
