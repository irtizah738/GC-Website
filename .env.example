# Server-only. Never prefix secrets with VITE_.
RESEND_API_KEY=
# Verified sender in your Resend account, e.g. Gotham Coders <contact@gothamcoders.com>
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=help@gothamcoders.com
SITE_ORIGIN=https://gothamcoders.com
# Optional public Firebase config; local marketing demos do not use Firebase.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIRESTORE_DATABASE_ID=(default)
